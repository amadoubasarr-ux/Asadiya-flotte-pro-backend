# ============================================================
# Asadiya Flotte PRO — configuration reverse proxy Nginx (EXEMPLE COMPLET)
#
# Ce fichier est fourni à titre de préparation : Nginx n'est PAS
# installé ni démarré à cette étape. Il s'installe sur l'hôte Docker
# (ou dans un conteneur) et reverse-proxie vers le conteneur « app ».
#
# Prérequis côté application :
#   - TRUST_PROXY=1 dans .env.docker (l'IP réelle du client est lue
#     derrière le proxy pour le rate limiting).
#   - CORS_ORIGIN doit contenir l'origine publique du frontend
#     (ex: https://flotte.example.com).
#   - Le conteneur « app » n'expose le port que sur 127.0.0.1 de
#     l'hôte (voir "app.ports" dans docker-compose.yml) afin que
#     Nginx soit la seule porte d'entrée publique.
#
# Installer sur Debian/Ubuntu :
#   sudo apt install nginx
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/asadiya-flotte
#   sudo ln -s /etc/nginx/sites-available/asadiya-flotte /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# HTTPS (voir deploy/https-letsencrypt.md) :
#   sudo apt install certbot python3-certbot-nginx
#   sudo certbot --nginx -d flotte.example.com
#   # puis activer le bloc HTTPS ci-dessous et le redirect 301 HTTP->HTTPS
# ============================================================

# Limite de débit au niveau du proxy (défense en profondeur en plus du
# rate limiting applicatif). À ajuster selon le trafic réel.
limit_req_zone $binary_remote_addr zone=asadiya_login:10m rate=10r/m;

# --- Serveur HTTP : redirection permanente vers HTTPS ---
# Le redirect 301 est ACTIF dans cet exemple (état final de production).
# Tant que le certificat n'existe pas, commentez la ligne return (sinon
# boucle de redirection). Certbot peut aussi gérer ce redirect avec :
#   sudo certbot --nginx -d flotte.example.com --redirect
server {
    listen 80;
    server_name flotte.example.com;

    return 301 https://$host$request_uri;
}

# --- Serveur HTTPS (actif après obtention du certificat Let's Encrypt) ---
server {
    listen 443 ssl;
    http2 on;
    server_name flotte.example.com;

    # Certificats générés par Certbot (ne PAS utiliser sur un serveur de test).
    ssl_certificate     /etc/letsencrypt/live/flotte.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/flotte.example.com/privkey.pem;

    # Durcissement TLS.
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # HSTS : demande aux navigateurs de n'utiliser que HTTPS pendant 6 mois
    # (à n'activer qu'une fois HTTPS confirmé, sinon risque de verrouillage).
    add_header Strict-Transport-Security "max-age=15768000; includeSubDomains" always;

    # Tailles des requêtes : doit correspondre à JSON_LIMIT (photos base64).
    client_max_body_size 15m;

    # Compression gzip des réponses textuelles.
    gzip on;
    gzip_types text/plain text/css application/json application/javascript;
    gzip_min_length 1024;

    # En-têtes de sécurité (défense en profondeur, en complément de Helmet :
    # CSP/COOP/COEP sont déjà posés par l'application).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Protection contre le brute force des identifiants (en plus du
    # rate limiting applicatif : LOGIN_RATE_LIMIT_MAX).
    location = /api/auth/login {
        limit_req zone=asadiya_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # --- API + frontend statique servis par l'application Node ---
    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        # Requis si des websockets/SSE sont ajoutés plus tard :
        proxy_set_header Connection        "";
        proxy_set_header Upgrade           $http_upgrade;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering on;
    }
}
