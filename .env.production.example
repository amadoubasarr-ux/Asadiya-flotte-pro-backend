# ============================================================
# Asadiya Flotte PRO — variables d'environnement PRODUCTION (EXEMPLE)
#
# Copiez ce fichier en ".env" (déploiement natif) ou utilisez-le comme
# référence pour construire ".env.docker" (déploiement Docker Compose) :
#   cp .env.production.example .env
#   chmod 600 .env            # seul l'utilisateur applicatif y a accès
#   openssl rand -hex 32      # pour générer JWT_SECRET
#
# AUCUN secret n'est stocké dans ce fichier : remplissez les champs vides
# avec des valeurs réelles. En production, le serveur REFUSE de démarrer si
# JWT_SECRET est faible, si CORS_ORIGIN est "*" ou si DATABASE_URL manque.
# ============================================================

# ===== Base de données PostgreSQL =====
# Exemple (PostgreSQL managé) : postgres://user:pass@db-hote.example.com:5432/asadiya_flotte
# Évitez les caractères réservés d'URL dans le mot de passe (:@/?#&).
DATABASE_URL=postgres://asadiya:REMPLACER@localhost:5432/asadiya_flotte
# TLS de la connexion Postgres : true si le serveur l'exige (p. ex. managé).
# false si le trafic passe déjà par un réseau privé / VPN.
DB_SSL=false
# Temps d'attente max (ms) pour ouvrir une connexion.
DB_CONNECTION_TIMEOUT_MS=10000
# Durée d'inactivité (ms) avant fermeture d'un client du pool.
DB_IDLE_TIMEOUT_MS=30000

# ===== Application =====
# Ne PAS changer : le serveur applique alors les contrôles de production.
NODE_ENV=production
# Port HTTP interne de l'API (derrière le reverse proxy).
PORT=4000
# Niveau de journalisation : debug | info | warn | error
# En production, les logs sortent en JSON ligne-à-ligne (collectables par Loki/ELK).
LOG_LEVEL=info

# ===== Authentification =====
# Chaîne aléatoire d'AU MOINS 32 caractères :  openssl rand -hex 32
JWT_SECRET=REMPLACER-par-une-chaine-aleatoire-d-au-moins-32-caracteres
# Durée de validité des jetons (ex: 7d, 24h, 3600)
JWT_EXPIRES_IN=7d
# Coût de hachage bcrypt (10-12 recommandé en production).
BCRYPT_ROUNDS=10

# ===== HTTP / Sécurité =====
# Limite de taille des corps JSON (les photos base64 peuvent être lourdes).
# Doit correspondre à client_max_body_size dans nginx.
JSON_LIMIT=15mb
# Origines autorisées (séparées par des virgules). "*" est REFUSÉ au démarrage.
CORS_ORIGIN=https://flotte.example.com

# ===== Reverse proxy & Rate limiting =====
# 1 (ou plus) si l'API est derrière nginx/Caddy (recommendé). Sinon 0.
TRUST_PROXY=1
# Fenêtre (ms) et nombre max de requêtes globales sur l'API (anti-DoS).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Limite stricte sur la connexion / l'inscription : seuls les ÉCHECS sont comptés.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20

# ===== SaaS (abonnements) =====
# Revenu récurrent estimé par véhicule (fallback MRR, en FCFA/centimes selon l'app).
PLATFORM_PRICE_PER_VEHICLE=5000
# Durée de la période d'essai (jours).
TRIAL_DAYS=14

# ===== Facturation =====
# provider: 'none' | 'wave' | 'orange_money' | 'stripe'
# 'none' = pas de paiement traité (architecture préparée uniquement).
# Les secrets des fournisseurs sont gérés par les sections « Paiements » ci-dessous.
BILLING_PROVIDER=none

# ===== Paiements (Phase 5.1 -> 5.4) =====
# Fournisseur actif : 'mock' | 'wave' | 'orange_money' | 'stripe'
# 'mock' par défaut : AUCUN paiement réel traité tant qu'un fournisseur
# réel n'est pas explicitement activé (WAVE_ENABLED/ORANGE_ENABLED/STRIPE_ENABLED).
PAYMENT_PROVIDER=mock
# Délai maximal (ms) avant expiration d'un paiement non complété.
PAYMENT_TIMEOUT=120000
# Secret partagé vérifié sur les webhooks 'mock' (en-tête x-webhook-secret).
# Requis (>= 16 caractères) en production dès qu'un fournisseur réel est activé.
PAYMENT_WEBHOOK_SECRET=

# --- Wave Money (Phase 5.2) ---
# URL de l'API Wave (production : https://api.wave.com).
WAVE_API_URL=https://api.wave.com
# Clé API de la boutique Wave (wave_sn_AKS_...) — authentification Bearer.
WAVE_API_KEY=
# Secret de signature des REQUÊTES sortantes (request signing).
WAVE_API_SECRET=
# Secret de signature des WEBHOOKS (wave_sn_WHS_...) — obligatoire si WAVE_ENABLED=true.
WAVE_WEBHOOK_SECRET=
# Délai max (ms) pour chaque appel à l'API Wave.
WAVE_TIMEOUT=30000
# URL de redirection après paiement réussi / échoué ou annulé (hosted checkout).
WAVE_SUCCESS_URL=https://flotte.example.com/paiement/succes
WAVE_ERROR_URL=https://flotte.example.com/paiement/erreur

# --- Orange Money (Phase 5.3) ---
# URL de base de l'API Orange Money (portail developer.orange.com).
ORANGE_API_URL=https://api.orange.com
# Identifiants OAuth2 client_credentials fournis à l'onboarding marchand.
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
# Identifiant marchand envoyé dans le corps de l'initiation (merchant_key).
ORANGE_MERCHANT_ID=
# Secret de vérification des WEBHOOKS (HMAC-SHA256, en-tête Orange-Signature).
ORANGE_WEBHOOK_SECRET=
# Chemins des endpoints (défauts = sandbox « dev » ; adapter au pays en production).
ORANGE_TOKEN_PATH=/oauth/v3/token
ORANGE_WEBPAYMENT_PATH=/orange-money-webpay/sn/v1/webpayment
ORANGE_TRANSACTION_STATUS_PATH=/orange-money-webpay/sn/v1/transactionstatus
# URL publique de réception des notifications (notif_url) : l'endpoint webhook
# https://votre-domaine/api/payments/webhook/orange_money
ORANGE_NOTIF_URL=https://flotte.example.com/api/payments/webhook/orange_money
# URL de redirection après paiement réussi / échoué ou annulé (hosted payment).
ORANGE_SUCCESS_URL=https://flotte.example.com/paiement/succes
ORANGE_ERROR_URL=https://flotte.example.com/paiement/erreur
# Délai max (ms) pour chaque appel à l'API Orange Money.
ORANGE_TIMEOUT=30000

# --- Stripe (Phase 5.4) ---
# URL de base de l'API Stripe (laisser la valeur par défaut en production).
STRIPE_API_URL=https://api.stripe.com
# Clé SECRÈTE (sk_...) — jamais exposée au navigateur, jamais journalisée.
STRIPE_SECRET_KEY=
# Clé PUBLIQUE (pk_...) — conçue par Stripe pour être livrée au navigateur.
STRIPE_PUBLISHABLE_KEY=
# Secret de vérification des WEBHOOKS (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Version de l'API Stripe envoyée dans l'en-tête Stripe-Version.
STRIPE_API_VERSION=2024-06-20
# Délai max (ms) pour chaque appel à l'API Stripe.
STRIPE_TIMEOUT=30000

# --- Activation des fournisseurs réels (tous désactivés par défaut) ---
# N'activez un fournisseur que lorsque ses identifiants ci-dessus sont remplis.
WAVE_ENABLED=false
ORANGE_ENABLED=false
STRIPE_ENABLED=false
