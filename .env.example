# Copiez ce fichier en ".env" et modifiez les valeurs avant la mise en production
# La plupart des valeurs ont des valeurs par défaut sûres pour le développement.

# Port HTTP du serveur API
PORT=4000

# ===== PostgreSQL =====
# URL de connexion : postgres://utilisateur:motdepasse@hote:port/base
DATABASE_URL=postgres://postgres:postgres@localhost:5432/asadiya_flotte
# Activer TLS (true) pour une base distante (RDS, Heroku, etc.)
DB_SSL=false
# Temps d'attente max (ms) pour ouvrir une connexion
DB_CONNECTION_TIMEOUT_MS=10000
# Durée d'inactivité (ms) avant fermeture d'un client du pool
DB_IDLE_TIMEOUT_MS=30000

# ===== Authentification =====
# IMPORTANT : en production, remplacez par une chaîne aléatoire d'au moins 32 caractères.
# Le serveur REFUSE de démarrer en production si JWT_SECRET est absent ou trop court.
JWT_SECRET=change-moi-en-production-asadiya-flotte-pro
# Durée de validité des jetons (ex: 7d, 24h)
JWT_EXPIRES_IN=7d
# Coût de hachage bcrypt
BCRYPT_ROUNDS=10

# ===== HTTP =====
# Limite de taille des corps JSON (les photos base64 peuvent être lourdes)
JSON_LIMIT=15mb
# Origines autorisées en production (séparées par des virgules). En développement, tout est autorisé.
# Ex: CORS_ORIGIN=https://flotte.example.com,https://admin.example.com
# IMPORTANT : en production, "*" (tout autoriser) est REFUSÉ au démarrage.
CORS_ORIGIN=*
# Environnement : development | production
NODE_ENV=development
# Niveau de journalisation : debug | info | warn | error
LOG_LEVEL=info

# ===== Reverse proxy & Rate limiting =====
# Nombre de sauts de proxy de confiance pour retrouver l'IP réelle du client.
# Mettre à 1 (ou plus) UNIQUEMENT si l'application est derrière nginx/Caddy/etc.
TRUST_PROXY=0
# Fenêtre (ms) et nombre max de requêtes globales sur l'API (anti-DoS).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Limite stricte sur la connexion / l'inscription : seuls les ÉCHECS sont comptés.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20

# ===== Paiements (Phase 5.1 → 5.4) =====
# Fournisseur actif : 'mock' | 'wave' | 'orange_money' | 'stripe'
PAYMENT_PROVIDER=mock
# Délai maximal (ms) avant expiration d'un paiement non complété.
PAYMENT_TIMEOUT=120000
# Secret partagé vérifié sur les webhooks de simulation 'mock'
# (en-tête x-webhook-secret). Les fournisseurs réels ont leur propre secret.
PAYMENT_WEBHOOK_SECRET=
# Activation des fournisseurs réels (tous désactivés par défaut).
WAVE_ENABLED=false
ORANGE_ENABLED=false
STRIPE_ENABLED=false

# ---- Wave Money (Phase 5.2, intégration réelle) ----
# URL de l'API Wave. Wave ne fournit pas de sandbox publique : laisser la
# valeur par défaut en production.
WAVE_API_URL=https://api.wave.com
# Clé API de la boutique Wave (format wave_sn_AKS_...) — authentification Bearer.
WAVE_API_KEY=
# Secret de signature des REQUÊTES sortantes (request signing). Requis en
# production dès que WAVE_ENABLED=true.
WAVE_API_SECRET=
# Secret de signature des WEBHOOKS (format wave_sn_WHS_...). Obligatoire dès
# que WAVE_ENABLED=true : tout webhook sans signature valide est refusé (401).
WAVE_WEBHOOK_SECRET=
# Délai max (ms) pour chaque appel à l'API Wave.
WAVE_TIMEOUT=30000
# URL de redirection après paiement réussi / échoué ou annulé (hosted checkout).
WAVE_SUCCESS_URL=
WAVE_ERROR_URL=

# ---- Orange Money (Phase 5.3, intégration réelle) ----
# URL de base de l'API Orange Money (portail developer.orange.com). Le
# segment de chemin des endpoints dépend du pays en production.
ORANGE_API_URL=https://api.orange.com
# Identifiants OAuth2 client_credentials fournis à l'onboarding marchand.
# (ils ne doivent JAMAIS apparaître côté navigateur).
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
# Identifiant marchand envoyé dans le corps de l'initiation (merchant_key).
ORANGE_MERCHANT_ID=
# Secret de vérification des WEBHOOKS (HMAC-SHA256, en-tête Orange-Signature).
# Obligatoire dès que ORANGE_ENABLED=true : tout webhook non signé est refusé (401).
ORANGE_WEBHOOK_SECRET=
# Chemins des endpoints. Les valeurs par défaut correspondent à la sandbox
# « dev » documentée ; en production, renseigner le chemin du pays
# (ex: /orange-money-webpay/sn/v1/webpayment pour le Sénégal).
ORANGE_TOKEN_PATH=/oauth/v3/token
ORANGE_WEBPAYMENT_PATH=/orange-money-webpay/dev/v1/webpayment
ORANGE_TRANSACTION_STATUS_PATH=/orange-money-webpay/dev/v1/transactionstatus
# URL publique de réception des notifications (notif_url) : l'endpoint webhook
# de cette application — https://votre-domaine/api/payments/webhook/orange_money
ORANGE_NOTIF_URL=
# URL de redirection après paiement réussi / échoué ou annulé (hosted payment).
ORANGE_SUCCESS_URL=
ORANGE_ERROR_URL=
# Délai max (ms) pour chaque appel à l'API Orange Money.
ORANGE_TIMEOUT=30000

# ---- Stripe (Phase 5.4, intégration réelle) ----
# URL de base de l'API Stripe. Laisser la valeur par défaut en production
# (utile uniquement pour les tests ou un proxy).
STRIPE_API_URL=https://api.stripe.com
# Clé SECRÈTE (sk_...) — jamais exposée au navigateur, jamais journalisée.
# Obligatoire dès que STRIPE_ENABLED=true.
STRIPE_SECRET_KEY=
# Clé PUBLIQUE (pk_...) — conçue par Stripe pour être livrée au navigateur
# (chargement de Stripe.js par le frontend). Obligatoire dès STRIPE_ENABLED=true.
STRIPE_PUBLISHABLE_KEY=
# Secret de vérification des WEBHOOKS (whsec_...). Obligatoire dès que
# STRIPE_ENABLED=true : tout webhook sans signature valide est refusé (401).
STRIPE_WEBHOOK_SECRET=
# Version de l'API Stripe envoyée dans l'en-tête Stripe-Version.
STRIPE_API_VERSION=2024-06-20
# Délai max (ms) pour chaque appel à l'API Stripe.
STRIPE_TIMEOUT=30000
